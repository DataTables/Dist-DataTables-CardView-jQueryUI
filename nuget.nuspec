<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>1.0.0-beta.1</version>
        <id>datatables.net-cardview-jqui</id>
        <description>This is CardView for DataTables with styling for [jQueryUI](http://jqueryui.com/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>https://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>Cards  Responsive  UI  jQueryUI  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-cardview" version="1.0.0-beta.1"/>
            <dependency id="datatables.net-jqui" version="1.0.0-beta.1"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/cardView.jqueryui.js" target="content\Scripts"/>
        <file src="js/cardView.jqueryui.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/cardView.jqueryui.min.js" target="content\Scripts"/>
        <file src="js/cardView.jqueryui.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/cardView.jqueryui.min.mjs" target="content\Scripts"/>
        <file src="js/cardView.jqueryui.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/cardView.jqueryui.mjs" target="content\Scripts"/>
        <file src="js/cardView.jqueryui.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/cardView.jqueryui.css" target="content\Content"/>
        <file src="css/cardView.jqueryui.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/cardView.jqueryui.min.css" target="content\Content"/>
        <file src="css/cardView.jqueryui.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
