{
    "name": "datatables.net-cardview-jqui",
    "description": "CardView for DataTables with styling for [jQueryUI](http://jqueryui.com/)",
    "main": "./js/cardView.jqueryui.js",
    "module": "./js/cardView.jqueryui.mjs",
    "style": "./css/cardView.jqueryui.css",
    "types": "./types/cardView.jqueryui.d.ts",
    "version": "1.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Cards",
        "Responsive",
        "jQuery UI",
        "jQueryUI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-cardview": "1.1.0",
        "datatables.net-jqui": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/cardView.jqueryui.d.ts",
            "import": "./js/cardView.jqueryui.mjs",
            "default": "./js/cardView.jqueryui.mjs",
            "require": "./js/cardView.jqueryui.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/cardView.jqueryui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}